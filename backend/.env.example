# Copy to .env and fill in real values. Never commit the actual .env file.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://gemstore_user:changeme@localhost:5432/gemstore?sslmode=disable
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-real-32+-char-random-secret

# --- Server / CORS (optional, defaults shown) --------------------------------
PORT=8080
# Must be the exact frontend origin — never a wildcard. Cookie-based auth
# requires this: browsers refuse credentialed requests against a wildcard CORS origin.
FRONTEND_ORIGIN=http://localhost:3000

# --- Auth token lifetimes (optional, defaults shown) -------------------------
# Access tokens are short-lived by design (stateless JWT, can't be revoked
# early — only allowed to expire). Refresh tokens are long-lived, revocable,
# and rotate on every use; see the README's "Auth model" section.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- Database pool (optional, defaults shown) --------------------------------
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=5s
DB_MAX_CONN_LIFETIME=1h

# --- Email via SendGrid (all optional — unset means emails are logged, not sent) ---
SENDGRID_API_KEY=
# EMAIL_FROM_ADDRESS must be a verified sender identity/domain in your SendGrid account.
EMAIL_FROM_ADDRESS=orders@example.com
EMAIL_FROM_NAME=Gem & Jewelry Store

# --- SMS via Twilio (all optional — unset means SMS is logged, not sent) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be a phone number provisioned on your Twilio account, in E.164 format.
TWILIO_PHONE_NUMBER=
